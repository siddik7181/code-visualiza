{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["extension/*.js", "test/*.mjs"],
  "exclude": ["node_modules", "extension/vendor"]
}
